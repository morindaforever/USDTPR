# Vite reads this in development; set VITE_API_BASE_URL to override.
# Copy to .env.local (or .env) if you need a non-default API location.

# Absolute URL of the Django API. Leave unset in development — the Vite dev
# server proxies /api/* to http://127.0.0.1:8000 (see vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8000/api

# Public URL of the frontend — used to build shareable referral links
# (Section 9). The backend's own PUBLIC_APP_URL is used for links served
# by the API; this one is available for any client-side link building.
VITE_PUBLIC_APP_URL=http://localhost:5173
