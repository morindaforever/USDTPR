# Vite reads this in development; set VITE_API_BASE_URL to override.
# Copy to .env.local (or .env) if you need a non-default API location.

# Absolute URL of the Django API. Leave unset in development — the Vite dev
# server proxies /api/* to http://127.0.0.1:8000 (see vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8000/api

# Public URL of the frontend — NOT needed for referral links: they are built
# from the runtime browser origin (window.location.origin), so they always
# match the deployed domain automatically, in dev and production alike.
