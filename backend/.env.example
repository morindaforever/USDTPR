# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# never set DEBUG=True outside local development
DEBUG=False
# generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-long-random-string

ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://usdt_platform:usdt_platform@localhost:5432/usdt_platform

# ---------------------------------------------------------------------------
# Redis / Celery (use redis://:password@host:port in production)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# CORS / CSRF — real frontend origins only; never use wildcards with cookies
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# Frontend base URL used to build shareable referral links
PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Uploads (deposit screenshots / withdrawal QR images)
# ---------------------------------------------------------------------------
# Maximum accepted image size in bytes (default 5 MB). Files are stored in
# private media and served only through authenticated admin/owner views —
# never through public static paths.
# MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# Blockchain integrations — ALL OFF by default (honest manual mode)
# ---------------------------------------------------------------------------
# Only enable when a real chain-access provider (node RPC or accredited
# indexer) is wired into apps/integrations/chain.py. The system refuses to
# fabricate verification results; enabling without a provider fails loudly.
# CHAIN_VERIFICATION_ENABLED=False
# Automated payout provider for withdrawals (apps/integrations/payouts.py).
# PAYOUTS_ENABLED=False
# Require completed KYC before withdrawals (apps/integrations/compliance.py).
# KYC_REQUIRED_FOR_WITHDRAWALS=False

# ---------------------------------------------------------------------------
# Production-only (config.settings.prod) — HTTPS must be live before enabling
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
